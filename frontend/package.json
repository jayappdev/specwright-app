    "deps:age": "node scripts/package-age.mjs"
  },
  "dependencies": {
    "mermaid": "12.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.3.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "rollup": "4.68.2",
    "postcss": "8.5.32",
