{
  "name": "codegen-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "themes": "node ../scripts/build-themes.mjs",
