# --- reference material, not part of the app -------------------------------
# the design prototype is a reference only
design/

# --- dependencies (restored by `npm ci` / `go mod download`) -----------------
frontend/node_modules/

# --- build output -------------------------------------------------------------
# the app bundle and binaries (`wails build`, `go build ./cmd/headless`)
build/bin/
/headless
/specwright
/SpecWright
*.exe
# the UI bundle is generated by `npm run build` (wails build runs it);
# keep the placeholder so `go:embed all:frontend/dist` compiles on a fresh clone
frontend/dist/*
!frontend/dist/.gitkeep
# dev server output, Wails-generated bindings and checksum
frontend/.dev/
frontend/wailsjs/
frontend/package.json.md5

# --- local tooling and OS files -------------------------------------------------
.claude/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- test and coverage output ---------------------------------------------------
*.test
*.out
coverage.*

# --- anything SpecWright itself writes into a project, if this repo is opened in it
.codegen/
